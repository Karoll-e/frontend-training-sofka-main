<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Dashboard - BankPro' %></title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <!-- Google Material Icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    />
    <link rel="stylesheet" href="/css/variables.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
  </head>
  <body>
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo">
          <img src="/img/logo.png" alt="BankPro Logo" class="logo-icon" />
          <span>BankPro</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <a
          href="/dashboard"
          class="nav-item <%= currentPath === '/dashboard' ? 'active' : '' %>"
        >
          <span class="material-symbols-outlined">home</span>
          <span>Panel</span>
        </a>
        <a
          href="/dashboard/transferencias"
          class="nav-item <%= currentPath === '/dashboard/transferencias' ? 'active' : '' %>"
        >
          <span class="material-symbols-outlined">swap_horiz</span>
          <span>Transferir</span>
        </a>
        <a
          href="/dashboard/transacciones"
          class="nav-item <%= currentPath === '/dashboard/transacciones' ? 'active' : '' %>"
        >
          <span class="material-symbols-outlined">receipt_long</span>
          <span>Transacciones</span>
        </a>
        <a
          href="/dashboard/cuentas"
          class="nav-item <%= currentPath === '/dashboard/cuentas' ? 'active' : '' %>"
        >
          <span class="material-symbols-outlined">account_balance</span>
          <span>Cuentas y Tarjetas</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <form action="/logout" method="POST" style="width: 100%">
          <button type="submit" class="btn-logout">
            <span class="material-symbols-outlined">logout</span>
            <span>Cerrar sesión</span>
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Dashboard Content -->
    <main class="dashboard-main">
      <!-- Header -->
      <header class="dashboard-header">
        <h1><%= pageTitle || 'Panel' %></h1>
        <div class="header-right">
          <span class="material-symbols-outlined">notifications</span>
          <div class="user-profile">
            <span class="user-avatar"
              ><%= usuario ? usuario.charAt(0).toUpperCase() : 'U' %></span
            >
            <span class="user-name"><%= usuario || 'Usuario' %></span>
            <span class="material-symbols-outlined">expand_more</span>
          </div>
        </div>
      </header>

      <!-- Success/Error Messages -->
      <% if (locals.success) { %>
      <div class="message-container" style="display: block">
        <div class="message-content success">
          <span class="material-symbols-outlined" id="messageIcon"
            >check_circle</span
          >
          <div><%= success %></div>
          <button
            class="close-message"
            onclick="this.parentElement.parentElement.style.display='none'"
          >
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
      </div>
      <% } %> <% if (locals.error) { %>
      <div class="message-container" style="display: block">
        <div class="message-content error">
          <span class="material-symbols-outlined" id="messageIcon">error</span>
          <div><%= error %></div>
          <button
            class="close-message"
            onclick="this.parentElement.parentElement.style.display='none'"
          >
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
      </div>
      <% } %>

      <!-- Page Content -->
      <%- body %>
    </main>

    <script src="/js/dashboard.js"></script>
    <script>
      // Auto-hide success/error messages after 5 seconds
      document.addEventListener("DOMContentLoaded", function () {
        const messageContainers =
          document.querySelectorAll(".message-container");
        messageContainers.forEach(function (container) {
          if (container.style.display !== "none") {
            setTimeout(function () {
              container.style.opacity = "0";
              setTimeout(function () {
                container.style.display = "none";
              }, 300);
            }, 3000);
          }
        });
      });
    </script>
  </body>
</html>
