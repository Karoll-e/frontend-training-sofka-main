<!-- src/views/pages/landing.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'BankPro - Banca Digital' %></title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">
            <img src="/img/logo.png" alt="BankPro Logo" class="logo-icon" />
            <span>BankPro</span>
        </div>

        <ul class="nav-center">
            <li><a href="#soluciones">Soluciones</a></li>
            <li><a href="#servicios">Servicios</a></li>
            <li><a href="#recursos">Recursos</a></li>
        </ul>

        <div class="nav-buttons">
            <a href="/login" class="btn btn-login">Login</a>
            <a href="/register" class="btn btn-signup">Crear cuenta</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">
                Olvídate del caos <span class="highlight">financiero</span> para siempre
            </h1>
            <p class="hero-subtitle">
                Controla tu dinero con una interfaz intuitiva y herramientas que te dan el poder de gestionar tus finanzas sin complicaciones.
            </p>

            <a href="/register" class="btn btn-get-started">Crear cuenta gratuita</a>
        </div>
    </section>
</body>
</html>