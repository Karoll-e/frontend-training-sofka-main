<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Login - BankPro' %></title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="login-container">
        <!-- Left Side - Login Form -->
        <div class="login-form-section">
            <div class="logo-section">
                <div class="logo">
                    <img src="/img/logo.png" alt="BankPro Logo" class="logo-icon">
                    <span>BankPro</span>
                </div>
            </div>
           
            <div class="form-container">
                <div class="welcome-text">
                    <h1>Hola,</h1>
                    <h2>Bienvenido de nuevo</h2>
                    <p>Ingresa tus credenciales para continuar</p>
                </div>
               
                <!-- Server-side error display -->
                <% if (locals.error) { %>
                    <div class="alert alert-error" style="background-color: #fee2e2; border: 1px solid #ef4444; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; font-family: var(--font-secondary); font-size: var(--font-size-sm);">
                        <%= error %>
                    </div>
                <% } %>
               
                <form class="login-form" id="loginForm" method="POST" action="/login">
                    <div class="input-group">
                        <input
                            type="text"
                            id="cedula"
                            name="cedula"
                            placeholder="Ingresa tu cédula"
                            required
                        >
                        <span class="error-message" id="cedulaError"></span>
                    </div>
                   
                    <div class="input-group">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Ingresa tu contraseña"
                            required
                        >
                        <span class="error-message" id="passwordError"></span>
                    </div>
                   
                    <button type="submit" class="btn btn-get-started">
                        Iniciar Sesión
                    </button>
                </form>
               
                <div class="signup-link">
                    <p>¿No tienes cuenta? <a href="/register" class="signup-text">Regístrate</a></p>
                </div>
            </div>
        </div>
       
        <!-- Right Side - Image -->
        <div class="login-image-section">
            <img src="/img/login-img.png" alt="Login Illustration" class="login-illustration">
        </div>
    </div>
   
    <script src="/js/formValidation.js"></script>
</body>
</html>
