<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><% if (typeof title !== 'undefined') { %><%= title %><% } else { %>Error - BankPro<% } %></title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/global.css">
    <style>
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: var(--color-bg);
            text-align: center;
            padding: var(--spacing-xl);
        }
        
        .error-container {
            max-width: 500px;
        }
        
        .error-code {
            font-size: 6rem;
            font-weight: 700;
            color: var(--color-primary-dark);
            margin: 0;
            line-height: 1;
        }
        
        .error-title {
            font-size: var(--font-size-2xl);
            font-weight: 600;
            color: var(--color-text);
            margin: var(--spacing-lg) 0;
        }
        
        .error-message {
            font-family: var(--font-secondary);
            font-size: var(--font-size-lg);
            color: var(--color-text-secondary);
            margin-bottom: var(--spacing-xl);
            line-height: 1.6;
        }
        
        .error-actions {
            display: flex;
            gap: var(--spacing-md);
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .btn-home {
            padding: var(--spacing-md) var(--spacing-xl);
            background-color: var(--color-primary-dark);
            color: white;
            text-decoration: none;
            border-radius: var(--radius-md);
            font-family: var(--font-secondary);
            font-weight: 600;
            font-size: var(--font-size-base);
            transition: all 0.3s ease;
        }
        
        .btn-home:hover {
            background-color: #1a2e26;
            transform: translateY(-2px);
        }
        
        .btn-back {
            padding: var(--spacing-md) var(--spacing-xl);
            background-color: transparent;
            color: var(--color-primary-dark);
            text-decoration: none;
            border: 2px solid var(--color-primary-dark);
            border-radius: var(--radius-md);
            font-family: var(--font-secondary);
            font-weight: 600;
            font-size: var(--font-size-base);
            transition: all 0.3s ease;
        }
        
        .btn-back:hover {
            background-color: var(--color-primary-dark);
            color: white;
            transform: translateY(-2px);
        }
        
        .logo {
            margin-bottom: var(--spacing-xl);
            font-size: var(--font-size-2xl);
            font-weight: 700;
            color: var(--color-primary-dark);
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="logo">BankPro</div>
        
        <h1 class="error-code"><% if (typeof statusCode !== 'undefined') { %><%= statusCode %><% } else { %>404<% } %></h1>
        <h2 class="error-title"><% if (typeof title !== 'undefined') { %><%= title %><% } else { %>Página no encontrada<% } %></h2>
        <p class="error-message">
            <% if (typeof error !== 'undefined') { %><%= error %><% } else { %>Lo sentimos, la página que buscas no existe o ha sido movida.<% } %>
        </p>
        
        <div class="error-actions">
            <a href="/" class="btn-home">Volver al inicio</a>
            <a href="javascript:history.back()" class="btn-back">Volver atrás</a>
        </div>
    </div>
</body>
</html>
