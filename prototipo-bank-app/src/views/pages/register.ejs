<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Registro - BankPro' %></title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <!-- Google Material Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/register.css">
</head>
<body>
    <div class="register-container">
        <!-- Left Side - Image -->
        <div class="register-image-section">
            <img src="/img/register-img.png" alt="Register Illustration" class="register-illustration">
        </div>

        <!-- Right Side - Register Form -->
        <div class="register-form-section">
            <div class="logo-section">
                <div class="logo">
                    <img src="/img/logo.png" alt="BankPro Logo" class="logo-icon">
                    <span>BankPro</span>
                </div>
            </div>
           
            <div class="form-container">
                <div class="welcome-text">
                    <h2>Crear cuenta</h2>
                    <p>Completa tus datos para comenzar</p>
                </div>
               
                <!-- Server-side error display -->
                <% if (locals.error) { %>
                    <div class="alert alert-error" style="background-color: #fee2e2; border: 1px solid #ef4444; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; font-family: var(--font-secondary); font-size: var(--font-size-sm);">
                        <%= error %>
                    </div>
                <% } %>
               
                <form class="register-form" id="registerForm" method="POST" action="/register">
                    <!-- Cédula -->
                    <div class="input-group">
                        <input
                            type="text"
                            id="cedula"
                            name="cedula"
                            placeholder="Cédula"
                            required
                        >
                        <span class="error-message" id="cedulaError"></span>
                    </div>

                    <!-- Nombre -->
                    <div class="input-group">
                        <input
                            type="text"
                            id="nombre"
                            name="nombre"
                            placeholder="Nombre"
                            required
                        >
                        <span class="error-message" id="nombreError"></span>
                    </div>

                    <!-- Apellido -->
                    <div class="input-group">
                        <input
                            type="text"
                            id="apellido"
                            name="apellido"
                            placeholder="Apellido"
                            required
                        >
                        <span class="error-message" id="apellidoError"></span>
                    </div>

                    <!-- Email -->
                    <div class="input-group">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Correo electrónico"
                            required
                        >
                        <span class="error-message" id="emailError"></span>
                    </div>

                    <!-- Teléfono -->
                    <div class="input-group">
                        <input
                            type="tel"
                            id="telefono"
                            name="telefono"
                            placeholder="Teléfono"
                            required
                        >
                        <span class="error-message" id="telefonoError"></span>
                    </div>
                   
                    <!-- Password -->
                    <div class="input-group">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Contraseña (mínimo 8 caracteres)"
                            required
                        >
                        <span class="error-message" id="passwordError"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="input-group">
                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Confirmar contraseña"
                            required
                        >
                        <span class="error-message" id="confirmPasswordError"></span>
                    </div>

                   
                    <button type="submit" class="btn btn-get-started">
                        Crear Cuenta
                    </button>
                </form>
               
                <div class="signin-link">
                    <p>¿Ya tienes cuenta? <a href="/login" class="signin-text">Inicia sesión</a></p>
                </div>
            </div>
        </div>
    </div>
   
    <script src="/js/formValidation.js"></script>
</body>
</html>
