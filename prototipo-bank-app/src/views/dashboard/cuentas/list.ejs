<div class="dashboard-content">
    <div class="left-column" style="grid-column: 1 / -1;">
        <section class="statistics-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-lg);">
                <h3 class="section-title">Mis Cuentas</h3>
                <a href="/dashboard/cuentas/crear" class="btn btn-primary" style="padding: var(--spacing-sm) var(--spacing-lg); text-decoration: none; font-size: var(--font-size-sm);">
                    <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                    Nueva Cuenta
                </a>
            </div>

            <!-- Success/Error Messages -->
            <% if (locals.success) { %>
                <div style="background-color: #f0fdf4; border: 1px solid #22c55e; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; font-family: var(--font-secondary); font-size: var(--font-size-sm);">
                    <%= success %>
                </div>
            <% } %>
            
            <% if (locals.error) { %>
                <div style="background-color: #fee2e2; border: 1px solid #ef4444; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; font-family: var(--font-secondary); font-size: var(--font-size-sm);">
                    <%= error %>
                </div>
            <% } %>

            <% if (cuentas && cuentas.length > 0) { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--spacing-lg);">
                    <% cuentas.forEach(function(cuenta) { %>
                        <div style="background: linear-gradient(135deg, var(--color-primary-dark) 0%, #2d4a3d 100%); border-radius: var(--radius-lg); padding: var(--spacing-xl); color: white;">
                            <p style="font-size: var(--font-size-xs); opacity: 0.9; margin: 0 0 var(--spacing-xs) 0;">Cuenta</p>
                            <h3 style="font-size: var(--font-size-xl); font-weight: 700; margin: 0 0 var(--spacing-lg) 0; font-family: 'Courier New', monospace; letter-spacing: 2px;">
                                <%= cuenta.numeroCuenta.match(/.{1,4}/g).join(' ') %>
                            </h3>
                            <p style="font-size: var(--font-size-xs); opacity: 0.9; margin: 0 0 var(--spacing-xs) 0;">Saldo disponible</p>
                            <h2 style="font-size: var(--font-size-2xl); font-weight: 700; margin: 0 0 var(--spacing-lg) 0;">
                                $<%= cuenta.saldoActual.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                            </h2>
                            <div style="display: flex; gap: var(--spacing-sm); margin-top: var(--spacing-md);">
                                <a href="/dashboard/cuentas/<%= cuenta.id %>" style="flex: 1; background: rgba(255,255,255,0.2); color: white; text-align: center; padding: var(--spacing-sm); border-radius: var(--radius-sm); text-decoration: none; font-size: var(--font-size-sm); transition: all 0.2s;">
                                    Ver detalles
                                </a>
                                <a href="/dashboard/cuentas/<%= cuenta.id %>/transaccion" style="flex: 1; background: white; color: var(--color-primary-dark); text-align: center; padding: var(--spacing-sm); border-radius: var(--radius-sm); text-decoration: none; font-size: var(--font-size-sm); font-weight: 600; transition: all 0.2s;">
                                    Transacción
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: var(--spacing-2xl); color: var(--color-text-secondary);">
                    <span class="material-symbols-outlined" style="font-size: 64px; opacity: 0.3;">account_balance</span>
                    <p style="margin: var(--spacing-lg) 0;">No tienes cuentas registradas</p>
                    <a href="/dashboard/cuentas/crear" class="btn btn-primary">Crear mi primera cuenta</a>
                </div>
            <% } %>
        </section>
    </div>
</div>
